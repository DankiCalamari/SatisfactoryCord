{
  "name": "satisfactorycord",
  "version": "1.0.0",
  "description": "A vanilla Satisfactory Dedicated Server wrapper and Discord bridge.",
  "type": "module",
  "bin": {
    "satisfactorycord": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "debug": "LOG_LEVEL=debug tsx src/index.ts",
    "probe": "tsx src/probe.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
