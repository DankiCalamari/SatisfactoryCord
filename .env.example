DISCORD_ENABLED=false
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_EVENTS_CHANNEL_ID=
DISCORD_CONSOLE_CHANNEL_ID=
DISCORD_CONSOLE_LEVEL=warning
DISCORD_ADMIN_ROLE_ID=

SATISFACTORY_EXECUTABLE=/opt/satisfactory/FactoryServer.sh
SATISFACTORY_ARGS=
SATISFACTORY_WORKING_DIRECTORY=/opt/satisfactory
SATISFACTORY_LOG_PATH=

SATISFACTORY_API_HOST=127.0.0.1
SATISFACTORY_API_PORT=7777
SATISFACTORY_API_TOKEN=
SATISFACTORY_API_REJECT_UNAUTHORIZED=false

RELAY_GAME_TO_DISCORD=true
RELAY_DISCORD_TO_GAME=true
RELAY_HIDE_IN_GAME_COMMANDS=true

CHAT_MODERATION_ENABLED=false
CHAT_BLOCKED_WORDS_FILE=config/blocked-words.txt
CHAT_BLOCKED_TERMS=
CHAT_BLOCKED_PATTERNS=
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_MAX_REPEATED_CHARACTERS=12
CHAT_BLOCK_DISCORD_MENTIONS=true
CHAT_MODERATION_NOTIFY_DISCORD=true

IN_GAME_ADMIN_ENABLED=false
IN_GAME_ADMIN_PREFIX=!sc
IN_GAME_ADMIN_PLAYERS=
IN_GAME_ADMIN_ALLOW_CONSOLE=false
IN_GAME_ADMIN_REQUIRE_EXACT_NAME_MATCH=true

AUTO_RESTART=true
AUTO_RESTART_DELAY=10
MAX_CRASH_RESTARTS=5
CRASH_RESTART_WINDOW=600

WEB_HOST=0.0.0.0
WEB_PORT=3000
LOG_LEVEL=info
LOG_DIR=logs
SERVER_CONSOLE_LOG=logs/server-console.log
BACKUP_RETENTION=10
STEAMCMD_PATH=/usr/games/steamcmd
SATISFACTORY_INSTALL_DIR=/opt/satisfactory
